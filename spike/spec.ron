// The whole screen is data. Swap this file and the picker changes shape.
(
    window: (title: "launcher"),
    theme: (
        accent: "#89b4fa",
        selected_bg: "#313244",
        text: "#cdd6f4",
    ),
    layout: Vertical(
        sizes: ["3", "fill", "1"],
        children: [
            Pane("query"),
            Pane("results"),
            Pane("status"),
        ],
    ),
    panes: [
        (id: "query", kind: Input, title: "search"),
        (
            id: "results",
            kind: Menu,
            title: "results",
            items: ["firefox", "kitty", "herdr"],
            keys: {
                "ctrl-j": None,          // explicit unset, beats the global bind
                "ctrl-n": Some(Down),    // pane override
            },
        ),
        (
            id: "status",
            kind: Text,
            title: "status",
            items: ["enter: run · tab: next pane · esc: quit"],
        ),
    ],
    keys: {
        "esc": Some(Quit),
        "tab": Some(FocusNext),
        "ctrl-j": Some(Down),
        "ctrl-k": Some(Up),
        "enter": Some(Accept),
    },
)
