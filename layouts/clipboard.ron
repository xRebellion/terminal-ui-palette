// The clipboard picker: cliphist's history on the left, the selected entry on
// the right, inside one titled card.
//
//   ╭─ Clipboard History ───────────────────────────────────────────╮
//   │                                                                │
//   │  > query▏                  30/30  │  the selected entry,       │
//   │  ─────────────────────────────────│  wrapped to the pane       │
//   │  › newest entry                  ▐│                            │
//   │    older entry…                   │                            │
//   │                                                                │
//   ╰────────────────────────────────────────────────────────────────╯
//
// One frame only — the window's — with the title on it, so nothing is boxed
// twice. Inside it, padding keeps text off the border; a rule under the query
// and a rule between the columns do the dividing, each with a blank cell on
// both sides. The count shares the query's row, dim, the way fzf's info line
// does (plan items 19, 21–23; the layout was revised 2026-11-21 after the
// user looked at it live).
//
// This file is data. No crate names it (docs/PLAN.md, D7).
(
    // Its own floating window, so the mouse is captured (docs/specs/21-mouse.md).
    window: (title: "Clipboard History", frame: true, mouse: true, padding: (x: 1, y: 1)),
    theme: (
        accent: "#f92672",
        // Monokai's own selection colour: visible on the terminal's background,
        // where the old near-black one barely was.
        selected_bg: "#3e3d32",
        hover_bg: "#2c2c26",
        text: "#f8f8f2",
        dim: "#75715e",
        scrollbar: "#57564a",
        scrollbar_bg: "#2c2c26",
    ),
    host: (width: 106, height: 26, class: "tuipalette"),
    layout: (
        dir: Horizontal,
        sizes: ["45%", "3", "fill"],
        children: [
            (
                dir: Vertical,
                sizes: ["1", "1", "fill"],
                children: [
                    // The query, with the count against the right edge of the
                    // same row. Ten cells hold `9999/9999` plus a gap; a larger
                    // count drops digits from the left, never the total's.
                    (dir: Horizontal, sizes: ["fill", "10"], children: [
                        (pane: "query"),
                        (pane: "count"),
                    ]),
                    (pane: "under-query"),
                    (pane: "list"),
                ],
            ),
            // Three cells: a blank, the line, a blank.
            (pane: "divider"),
            (pane: "preview"),
        ],
    ),
    panes: [
        (id: "query", kind: Input, title: "> ", frame: false),
        (id: "count", kind: Counter, align: Right, frame: false),
        (id: "under-query", kind: Rule, frame: false),
        // One click pastes, like the launcher (docs/specs/21-mouse.md). The
        // scrollbar says how deep in a 250-entry history the selection is.
        (id: "list", kind: Menu, frame: false, click: Accept, scrollbar: true),
        (id: "divider", kind: Rule, frame: false),
        // The selected entry: its picture where the terminal can draw one
        // (kitty, D22), its text everywhere else and for text entries.
        (id: "preview", kind: Image, from: "list", frame: false, wrap: true),
    ],
    keys: {
        "esc": Some(Quit),
        "enter": Some(Accept),
    },
)
